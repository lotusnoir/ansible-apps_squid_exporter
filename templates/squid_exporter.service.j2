{{ ansible_managed | comment }}

[Unit]
Description=Prometheus squid Exporter
After=network-online.target
StartLimitInterval=0

[Service]
Type=simple
Restart=always
User=squid_exporter
Group=squid_exporter
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=yes
ExecStart={{ squid_exporter_install_dir }}/squid-exporter \
{% if squid_exporter_extra_flags is defined and squid_exporter_extra_flags != "" %}        {{ squid_exporter_extra_flags }} \
{% endif %}
        -squid-hostname "{{ squid_exporter_squid_host }}" \
        -squid-port {{ squid_exporter_squid_port }} \
        -listen "{{ squid_exporter_listen_address }}:{{ squid_exporter_listen_port }}"
ExecReload=/bin/kill -HUP $MAINPID
SyslogIdentifier=squid_exporter
RestartSec=1
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
