{{ ansible_managed | comment }}

[Unit]
Description=Prometheus squid Exporter
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User={{ squid_exporter_user }}
Group={{ squid_exporter_group }}

ExecStart={{ squid_exporter_install_dir }}/{{ squid_exporter_binary_name }} \
{% for flag in squid_exporter_extra_flags %}        {{ flag }} \
{% endfor %}
        -squid-hostname "{{ squid_exporter_squid_host }}" \
        -squid-port {{ squid_exporter_squid_port }} \
        -listen "{{ squid_exporter_listen_address }}:{{ squid_exporter_listen_port }}"
ExecReload=/bin/kill -HUP $MAINPID
SyslogIdentifier=squid_exporter

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
